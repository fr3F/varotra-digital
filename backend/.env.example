# --- Serveur ---
PORT=3000
DATABASE_PATH=data/carnet-backend.db

# --- Meta (developers.facebook.com > votre application > Messenger) ---
# Secret de l'application (Paramètres > Général) : vérifie la signature de chaque webhook.
META_APP_SECRET=remplacez-par-le-secret-de-l-application
# Jeton libre, à recopier dans Meta lors de la configuration du webhook.
META_VERIFY_TOKEN=choisissez-un-jeton-long
# Identifiant de l'application (Paramètres > Général) : active « Se connecter avec Facebook »,
# chaque boutique relie sa propre Page. Vide : désactivé.
META_APP_ID=
# Jeton de la Page de la boutique « default » (ancienne configuration à une seule Page).
# Laissez vide pour le mode simulation (rien n'est envoyé à Meta).
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0
# Boutons du bot : text_first (texte numéroté lisible sur Facebook Lite, puis boutons), template ou quick_replies.
META_BUTTON_STYLE=text_first

# --- Application mobile ---
# Ancien code d'appairage : relie un téléphone à la boutique « default ».
APP_PAIRING_CODE=changez-ce-code
# Jeton de la page /admin (boutiques, codes d'activation, abonnements), 16 caractères minimum.
# Vide : /admin désactivé.
ADMIN_TOKEN=
# Origines web autorisées (version web de l'application), séparées par des virgules.
CORS_ORIGINS=http://localhost:8081

# --- Pages publiques exigées par Meta (/privacy, /data-deletion) ---
BUSINESS_NAME=Carnet Digital
CONTACT_EMAIL=

# --- Développement uniquement ---
# Active /dev/outgoing (lu par le simulateur). Ne jamais activer en production.
DEV_TOOLS=false
