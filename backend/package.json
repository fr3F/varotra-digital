{
  "name": "carnet-digital-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend intermédiaire Facebook Messenger ↔ application Carnet Digital",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "worker:dev": "wrangler dev",
    "cloudflare:deploy": "node scripts/cloudflare-deploy.ts",
    "deploy": "wrangler deploy",
    "simulate": "node --env-file-if-exists=.env scripts/simulate.ts",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=75 --test-coverage-exclude=\"test/**\" \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13"
  }
}
