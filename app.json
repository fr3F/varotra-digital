{
  "expo": {
    "name": "Carnet Digital",
    "slug": "carnet-digital",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "mg.carnetdigital.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Carnet Digital a besoin de vos photos pour illustrer vos produits.",
          "cameraPermission": "Carnet Digital a besoin de l’appareil photo pour photographier vos produits."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#A3161D"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#A3161D",
          "image": "./assets/splash-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-localization",
      "expo-web-browser"
    ],
    "scheme": "carnetdigital",
    "experiments": {
      "typedRoutes": true
    },
    "owner": "frazakarivony",
    "extra": {
      "eas": {
        "projectId": "b95c0b79-3ae8-4aa6-9a64-b44f01272a98"
      }
    }
  }
}
