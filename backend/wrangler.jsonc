// Cloudflare Workers + D1 (offre gratuite, sans carte bancaire).
// Les secrets (META_APP_SECRET, META_VERIFY_TOKEN, APP_PAIRING_CODE, META_PAGE_ACCESS_TOKEN, ADMIN_TOKEN)
// ne sont jamais écrits ici : `npm run cloudflare:deploy` les crée avec `wrangler secret put`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carnet-digital-backend",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Relance des paniers abandonnés (une fois, dans les 24 h de Messenger).
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": {
    "META_GRAPH_API_VERSION": "v25.0",
    // Identifiant de l'application Meta (Paramètres > Général) : active « Se connecter avec Facebook »
    // pour que chaque boutique relie sa propre Page. Vide : désactivé.
    "META_APP_ID": "1410679937246801",
    // Boutons du bot : "text_first" (texte numéroté lisible sur Facebook Lite, puis boutons),
    // "template" (boutons dans la bulle) ou "quick_replies".
    "META_BUTTON_STYLE": "text_first",
    "BUSINESS_NAME": "Carnet Digital",
    "CONTACT_EMAIL": "frazakarivony.dev@gmail.com",
    "CORS_ORIGINS": "",
    "DEV_TOOLS": "false",
    // Dernière APK (lien « Download » du build EAS) : https://…workers.dev/apk y redirige.
    // À mettre à jour à chaque nouvelle APK, puis npm run deploy. Vide : /apk répond « pas disponible ».
    "APK_URL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carnet-backend",
      // Renseigné automatiquement par `npm run cloudflare:deploy`.
      "database_id": "c29cafc6-1c5e-4c5f-898f-f6c2342f9fb5",
      "migrations_dir": "migrations"
    }
  ]
}
